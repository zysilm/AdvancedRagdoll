<Project Sdk="Microsoft.NET.Sdk">
  <!-- The library used the way another .NET game would use it: it references the library project only (no
       InternalsVisibleTo), so it compiles against the public API alone. See README.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\AdvancedRagdoll.csproj" />
  </ItemGroup>
</Project>
